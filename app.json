{
  "expo": {
    "name": "VaultPeerMobile",
    "slug": "VaultPeerMobile",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/android-chrome-512x512.png",
    "scheme": "vaultpeermobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/android-chrome-512x512.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vaultpeer.app",
      "icon": "./assets/apple-touch-icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "VaultPeer uses Face ID to unlock your password vault."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-chrome-512x512.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.vaultpeer.app",
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon-96x96.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/android-chrome-512x512.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0F0E",
          "dark": {
            "backgroundColor": "#0B0F0E"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a"],
            "enableProguardInReleaseBuilds": true
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-secure-store",
      "expo-document-picker",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "VaultPeer uses Face ID to unlock your vault securely."
        }
      ],
      "react-native-quick-crypto"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a96f275c-df7d-4d4a-b4b2-17b654719a33"
      }
    }
  }
}
